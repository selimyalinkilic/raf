{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.12.0",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "contextMenus",
    "cookies",
    "downloads",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.ts.net/*",
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.vimeo.com/*",
    "*://*.reddit.com/*",
    "*://*.twitch.tv/*",
    "*://*.dailymotion.com/*",
    "*://*.linkedin.com/*",
    "*://*.pinterest.com/*",
    "*://*.threads.net/*",
    "*://*.threads.com/*",
    "*://*.bsky.app/*"
  ],
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdQuickSave__"
    },
    "insert-uuid": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "__MSG_cmdUuid__"
    },
    "pick-locator": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_cmdPicker__"
    },
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "__MSG_cmdFill__"
    }
  },
  "default_locale": "en",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.vimeo.com/*",
        "*://*.reddit.com/*",
        "*://*.twitch.tv/*",
        "*://*.dailymotion.com/*",
        "*://*.linkedin.com/*",
        "*://*.pinterest.com/*",
        "*://*.threads.net/*",
        "*://*.threads.com/*",
        "*://*.bsky.app/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
